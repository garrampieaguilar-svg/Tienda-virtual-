# ------------------------------------------------------------------
# Copiá este archivo como .env.local y completá los valores.
# Los encontrás en Supabase: Project Settings → API.
# ------------------------------------------------------------------

# URL del proyecto de Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública "anon" / "publishable" (pública, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" / "secret" (SECRETA: solo servidor y script de importación).
# Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para los links de login por email y Google).
# En local: http://localhost:3000 — En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
